    "store-definitions.mjs",
    "StoreCommandRunner.mjs",
    "WorkbenchArcTree.mjs",
    "WorkbenchArcTree.d.mts",
    "arc-tree-manifest.mjs",
    "arc-tree-preload.mjs",
    "workbench-daemon.mjs",
    "workbench-daemon.d.mts",
