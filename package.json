{
  "name": "workbench-root",
  "private": true,
  "scripts": {
    "app": "node app/node_modules/tsx/dist/cli.mjs app/index.ts",
    "build:tray": "node scripts/build-tray.mjs",
    "test": "node --disable-warning=ExperimentalWarning --import tsx test/run-project-tests.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "dev": "node --env-file-if-exists=./daemon/.env.local --import tsx ./runner/index.ts",
    "codex:types": "codex app-server generate-ts --experimental --out ./shared/codex/generated/app-server"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^25.6.0",
    "better-sqlite3": "13.0.3",
    "tsx": "4.21.0",
    "typescript": "^7.0.2"
  }
}
