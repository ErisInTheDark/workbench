{
  "name": "workbench-root",
  "private": true,
  "scripts": {
    "app": "node --disable-warning=ExperimentalWarning app/server/launch.mjs",
    "build:app": "node --import tsx app/server/build.ts",
    "build:tray": "node scripts/build-tray.mjs",
    "build:host": "node scripts/build-host.mjs",
    "test:native": "node scripts/test-native.mjs",
    "build:network": "node scripts/build-network.mjs",
    "test:network": "node scripts/test-network.mjs",
    "build:repo": "node scripts/build-repo.mjs",
    "test:repo": "node scripts/test-repo.mjs",
    "build:relay": "node scripts/build-relay.mjs",
    "test:relay": "node scripts/test-relay.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "test": "node --disable-warning=ExperimentalWarning --import tsx test/run-project-tests.mjs",
    "test:thread": "node --disable-warning=ExperimentalWarning --import tsx test/run-thread-test.mjs",
    "test:lifecycle": "node --disable-warning=ExperimentalWarning --import tsx test/run-lifecycle-test.mjs",
    "test:install": "node --disable-warning=ExperimentalWarning --import tsx test/run-install-test.mjs",
    "sandbox:install": "node --disable-warning=ExperimentalWarning --import tsx test/install/open-install-sandbox.ts",
    "typecheck": "node --disable-warning=ExperimentalWarning --import tsx scripts/typecheck.mjs",
    "dev": "node --env-file-if-exists=./daemon/.env.local ./daemon/host/launch-foreground.mjs",
    "codex:types": "pnpm --dir daemon exec codex app-server generate-ts --experimental --out ../shared/codex/generated/app-server",
    "pack": "node scripts/publish-package.mjs --pack",
    "publish:package": "node scripts/publish-package.mjs --publish"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.6.0",
    "better-sqlite3": "13.0.3",
    "tsx": "4.23.13",
    "typescript": "7.1.0-beta"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.9.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  }
}
