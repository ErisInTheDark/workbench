#!/usr/bin/env bash
# No exports. Root Workbench dispatcher keeps daemon-backed commands on the shell fast path.
set -u

if [[ "${WORKBENCH_CWD_REDIRECTED:-}" != "1" ]]; then
  cwd_workbench="$PWD/wb"
  if [[ -f "$cwd_workbench" ]] && ! [[ "$cwd_workbench" -ef "$0" ]]; then
    WORKBENCH_CWD_REDIRECTED=1 exec bash "$cwd_workbench" "$@"
  fi
fi
workbench_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) launcher="$workbench_root/daemon/launcher/bin/windows-x64/wb.exe" ;;
  *) launcher="$workbench_root/daemon/launcher/bin/linux-x64/wb" ;;
esac
thread_id="${WORKBENCH_THREAD_ID:-${CODEX_THREAD_ID:-}}"
hook_mode=0
checkout_mode=0
human_only=0
if [[ "$#" -eq 0 && "${WORKBENCH_APPLY_PATCH_CLAIM_HOOK:-}" == "1" ]]; then
  hook_mode=1
elif [[ "${1:-}" == "__hook" && "${2:-}" == "apply-patch-claim" && "$#" -eq 2 ]]; then
  hook_mode=1
elif [[ "$#" -eq 1 && "${1:-}" == "ports" ]]; then
  checkout_mode=1
elif [[ "$#" -eq 0 ]] || { [[ "$#" -eq 1 ]] && [[ "${1:-}" == "shortcut" || "${1:-}" == "connect" || "${1:-}" == "disconnect" || "${1:-}" == "repair" ]]; }; then
  checkout_mode=1
  human_only=1
elif [[ "${1:-}" == "view" ]] && { [[ "$#" -eq 1 ]] || [[ "$#" -eq 2 && ( "${2:-}" == "daemon" || "${2:-}" == "app" ) ]]; }; then
  checkout_mode=1
  human_only=1
fi

if (( hook_mode == 1 || checkout_mode == 0 )) || { [[ -n "$thread_id" ]] && (( human_only == 1 )); }; then
  if [[ ! -f "$launcher" ]]; then
    printf '%s\n' "Workbench wb launcher is unavailable: $launcher. Run pnpm build:launcher." >&2
    exit 1
  fi
  # Git Bash and MSYS2 would otherwise rewrite /path-like arguments on their way into a native image.
  WORKBENCH_CHECKOUT_ROOT="$workbench_root" MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL="*" exec "$launcher" "$@"
fi

exec node --disable-warning=ExperimentalWarning "$workbench_root/cli/dispatch.mjs" "$@"
