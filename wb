#!/usr/bin/env bash
# Root Workbench dispatcher. Keep daemon-backed commands on the shell fast path.
set -u

if [[ "${WORKBENCH_CWD_REDIRECTED:-}" != "1" ]]; then
  cwd_workbench="$PWD/wb"
  if [[ -f "$cwd_workbench" ]] && ! [[ "$cwd_workbench" -ef "$0" ]]; then
    WORKBENCH_CWD_REDIRECTED=1 exec bash "$cwd_workbench" "$@"
  fi
fi
unset WORKBENCH_CWD_REDIRECTED

workbench_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
daemon_cli="$workbench_root/daemon/server/lib/workbench/cli/workbench-agent-cli.sh"
thread_id="${WORKBENCH_THREAD_ID:-${CODEX_THREAD_ID:-}}"
hook_mode=0
human_mode=0
if [[ "$#" -eq 0 && "${WORKBENCH_APPLY_PATCH_CLAIM_HOOK:-}" == "1" ]]; then
  hook_mode=1
elif [[ "${1:-}" == "__hook" && "${2:-}" == "apply-patch-claim" && "$#" -eq 2 ]]; then
  hook_mode=1
elif [[ "$#" -eq 0 ]] || { [[ "$#" -eq 1 ]] && [[ "${1:-}" == "shortcut" || "${1:-}" == "connect" || "${1:-}" == "disconnect" ]]; }; then
  human_mode=1
elif [[ "$#" -eq 2 && "${1:-}" == "view" && ( "${2:-}" == "daemon" || "${2:-}" == "app" ) ]]; then
  human_mode=1
fi

if (( hook_mode == 1 )) || [[ -n "$thread_id" ]] || (( human_mode == 0 )); then
  if [[ ! -f "$daemon_cli" ]]; then
    printf '%s\n' "Workbench daemon CLI is unavailable: $daemon_cli" >&2
    exit 1
  fi
  export WORKBENCH_DAEMON_ORIGIN_RESOLVER="$workbench_root/daemon/server/lib/workbench/cli/resolve-workbench-daemon-origin.mts"
  exec bash "$daemon_cli" "$@"
fi

exec node --disable-warning=ExperimentalWarning "$workbench_root/package/dispatch.mjs" "$@"
